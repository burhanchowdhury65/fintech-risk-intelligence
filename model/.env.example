# Copy this file to .env and adjust if needed. All values shown are the defaults
# already used if .env is missing entirely — so this file is optional for local dev.

# Host/port the Fraud/Risk Node listens on. Per Person A's Day 5 confirmation, this is
# a SEPARATE service from the main backend (which runs its own /analyze on 127.0.0.1:8000).
FRAUD_NODE_HOST=127.0.0.1
FRAUD_NODE_PORT=8001
